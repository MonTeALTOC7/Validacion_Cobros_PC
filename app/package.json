{
  "name": "conciliador-casur",
  "private": true,
  "version": "0.8.0",
  "description": "Conciliador Nómina–Prefactura CASUR · fuente editable",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/upgrade.mjs && node tests/e2e/timezone.mjs",
    "compare": "vite-node tests/e2e/compare-legacy.mjs -- --report-only",
    "engine": "vite-node tests/tools/run-engine.mjs --",
    "release": "npm run build && node scripts/release.mjs",
    "verify": "npm test && npm run build && node tests/e2e/smoke.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:legacy": "node scripts/verify-legacy.mjs",
    "compare:check": "vite-node tests/e2e/compare-legacy.mjs -- --allowlist tests/golden/legacy-allowlist.json",
    "golden:update": "vite-node scripts/golden-update.mjs --"
  },
  "dependencies": {
    "dexie": "4.4.5",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.47.2",
    "prettier": "^3.3.3",
    "vite": "5.4.21",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "2.1.9"
  }
}
